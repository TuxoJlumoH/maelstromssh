pkgbase = maelstromssh
	pkgdesc = SSH/SFTP client with CLI, terminal UI, graphical and browser front-ends
	pkgver = 0.4.0
	pkgrel = 1
	url = https://github.com/TuxoJlumoH/maelstromssh
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = cargo
	makedepends = git
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	optdepends = libxkbcommon: GUI keyboard input
	optdepends = wayland: GUI on Wayland
	optdepends = libglvnd: GUI rendering (EGL)
	optdepends = libx11: GUI on X11
	optdepends = libxcursor: GUI on X11
	optdepends = libxi: GUI on X11
	optdepends = openssh: ssh-agent for key-based login
	options = !lto
	source = maelstromssh-0.4.0::git+ssh://git@github.com/TuxoJlumoH/maelstromssh.git#tag=v0.4.0
	sha256sums = SKIP

pkgname = maelstromssh
